# Development Environment Variables for InvestByYourself
# Copy this file to .env.dev and update the values

# Database Configuration
DATABASE_TYPE=sqlite
SQLITE_DATABASE=investbyyourself_dev.db
REDIS_PASSWORD=your_redis_password_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here

# API Keys (Optional for development)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key_here
FRED_API_KEY=your_fred_api_key_here

# Supabase Configuration (Optional - for authentication)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# MinIO Configuration (Optional)
MINIO_ENDPOINT=your_minio_endpoint_here
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET_NAME=your_bucket_name_here

# Development Settings
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
