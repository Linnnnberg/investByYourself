# syntax=docker/dockerfile:1.7
# Shared Base Dockerfile
# Tech-020: Microservices Foundation
#
# Build with BuildKit enabled (default in Docker 23+):
#   DOCKER_BUILDKIT=1 docker build -t ibyy-base -f Dockerfile.base .

# Base image for all services
FROM python:3.11-slim as base

# Note: PIP_NO_CACHE_DIR is intentionally NOT set so the cache mount below
# can persist wheels between builds. The cache lives in BuildKit storage.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

# Install common system dependencies (cache APT layers across rebuilds)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory and user
WORKDIR /app
RUN adduser --disabled-password --gecos '' appuser

# Copy requirements and install dependencies (cached pip wheels)
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.txt

# Development stage
FROM base as development

# Install development dependencies
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install \
    pytest \
    pytest-asyncio \
    pytest-mock \
    black \
    flake8 \
    mypy \
    isort

# Copy source code
COPY . .
RUN chown -R appuser:appuser /app

# Set development environment
ENV ENVIRONMENT=development
ENV DEBUG=true

# Production stage
FROM base as production

# Copy source code
COPY --chown=appuser:appuser . .

# Set production environment
ENV ENVIRONMENT=production
ENV DEBUG=false

# Switch to non-root user
USER appuser

# Common health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:${PORT:-8000}/health')" || exit 1
