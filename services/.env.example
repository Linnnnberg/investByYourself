# =====================================================
# InvestByYourself Microservices - Development Environment
# =====================================================
# For use with: services/docker-compose.yml
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env to version control (already in .gitignore)
# 4. Keep your API keys and passwords secure
#
# For Production: Use .env.production.example instead
# =====================================================

# =====================================================
# BUILD & ENVIRONMENT CONFIGURATION
# =====================================================

# Build Target (development, testing, production)
BUILD_TARGET=development

# Environment Mode
ENVIRONMENT=development

# Debug Mode
DEBUG=true

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

# PostgreSQL Database
# Generate password: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_USER=postgres
POSTGRES_DB=investbyyourself
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =====================================================
# REDIS CACHE CONFIGURATION
# =====================================================

# Inside Docker (microservices talking to each other): REDIS_HOST=redis
# Outside Docker (local scripts, dev tools): REDIS_HOST=localhost
# Generate password: openssl rand -base64 32
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =====================================================
# MINIO OBJECT STORAGE
# =====================================================

# MinIO Credentials
# Generate password: openssl rand -base64 32
MINIO_ROOT_USER=investbyyourself
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =====================================================
# SERVICE CONFIGURATION
# =====================================================

# ETL Service Settings
ETL_BATCH_SIZE=100
ETL_MAX_WORKERS=4
ETL_RETRY_ATTEMPTS=3
ETL_RETRY_DELAY=5

# Financial Analysis Service Settings
ANALYSIS_CACHE_TTL=3600
ANALYSIS_MAX_WORKERS=4

# Data Service Settings
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=30

# =====================================================
# API KEYS (Optional for Development)
# =====================================================

# Alpha Vantage API
# Get free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# FRED API (Federal Reserve Economic Data)
# Get free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Financial Modeling Prep API (Optional)
FMP_API_KEY=your_fmp_api_key_here

# =====================================================
# MONITORING & OBSERVABILITY (Optional)
# =====================================================

# Prometheus Metrics
PROMETHEUS_PORT=9090

# Grafana Dashboard
# Generate password: openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
GRAFANA_PORT=3000

# Sentry Error Tracking (Optional)
SENTRY_DSN=your_sentry_dsn_here

# =====================================================
# ADMIN TOOLS (Optional)
# =====================================================

# PgAdmin Database Management
PGADMIN_DEFAULT_EMAIL=admin@investbyyourself.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=8080

# Redis Commander
REDIS_COMMANDER_PORT=8081

# =====================================================
# QUICK START GUIDE
# =====================================================
#
# REQUIRED (must set before running):
#   - POSTGRES_PASSWORD
#   - REDIS_PASSWORD
#   - MINIO_ROOT_PASSWORD
#
# RECOMMENDED (for full functionality):
#   - ALPHA_VANTAGE_API_KEY (for market data)
#   - FRED_API_KEY (for economic data)
#
# OPTIONAL (for extended features):
#   - Monitoring tools (Grafana, Prometheus)
#   - Admin tools (PgAdmin, Redis Commander)
#   - Error tracking (Sentry)
#
# Start microservices:
#   cd services
#   docker-compose up -d
#
# Verify health:
#   docker-compose ps
#   curl http://localhost:8000/health  # ETL Service
#   curl http://localhost:8001/health  # Financial Analysis Service
#   curl http://localhost:8002/health  # Data Service
#
# View logs:
#   docker-compose logs -f
#
# Stop services:
#   docker-compose down
#
# Access admin tools:
#   MinIO Console: http://localhost:9001
#   Grafana: http://localhost:3000
#   PgAdmin: http://localhost:8080
#
# =====================================================
