# =====================================================
# InvestByYourself Development Environment
# =====================================================
# For use with: docker-compose.dev.yml
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env to version control (already in .gitignore)
# 4. Keep your API keys and passwords secure
#
# Security Notes:
# - Generate secure passwords (not 'password123')
# - Use unique passwords for each service
# - Store in password manager (1Password, Bitwarden, etc.)
# - For production, use proper secret management
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

# PostgreSQL Database
# Used by: API, ETL services
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis Cache
# Used by: API, ETL services for caching
# Generate: openssl rand -base64 32
REDIS_PASSWORD=your_secure_redis_password_here

# =====================================================
# SECURITY & AUTHENTICATION
# =====================================================

# JWT Secret Key
# SECURITY CRITICAL: Used for signing authentication tokens
# Requirements:
# - MUST be unique and random (minimum 32 characters recommended)
# - NEVER use default/example values in production or development
# - NEVER commit actual secrets to version control
# - Rotate periodically for security
# 
# Generate a secure key:
#   Option 1: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Option 2: openssl rand -base64 32
#   Option 3: Use services/setup_env.py (auto-generates)
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# =====================================================
# EXTERNAL API KEYS
# =====================================================

# Alpha Vantage API
# Get free key: https://www.alphavantage.co/support/#api-key
# Used for: Stock market data, financial statements
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# FRED API (Federal Reserve Economic Data)
# Get free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used for: Economic indicators, macro data
FRED_API_KEY=your_fred_api_key_here

# Financial Modeling Prep API (Optional)
# Get key: https://financialmodelingprep.com/developer/docs/
# Used for: Enhanced financial metrics
FMP_API_KEY=your_fmp_api_key_here

# Yahoo Finance (Optional)
# No API key required, but rate limiting applies
YAHOO_FINANCE_API_KEY=

# =====================================================
# SUPABASE CONFIGURATION (Optional)
# =====================================================
# For authentication features
# Get from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =====================================================
# MINIO OBJECT STORAGE (Optional)
# =====================================================
# For file storage and backups
# Only needed if using MinIO service

MINIO_ROOT_USER=your_minio_username_here
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_SECRET_KEY=your_minio_secret_key_here

# =====================================================
# APPLICATION SETTINGS
# =====================================================

# Environment Mode
# Options: development, staging, production
ENVIRONMENT=development

# Debug Mode
# Enable detailed logging and error messages
DEBUG=true

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =====================================================
# ETL CONFIGURATION
# =====================================================

# Batch Size for data processing
ETL_BATCH_SIZE=100

# Maximum worker threads
ETL_MAX_WORKERS=4

# Retry configuration
ETL_RETRY_ATTEMPTS=3
ETL_RETRY_DELAY=5

# =====================================================
# PERFORMANCE SETTINGS
# =====================================================

# Database Connection Pool
MAX_CONNECTIONS=20
CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=60

# Data Collection Interval (seconds)
DATA_COLLECTION_INTERVAL=900  # 15 minutes

# =====================================================
# MONITORING & OBSERVABILITY (Optional)
# =====================================================

# Sentry Error Tracking
# Get DSN: https://sentry.io/settings/projects/
SENTRY_DSN=your_sentry_dsn_here

# Prometheus Metrics Port
PROMETHEUS_PORT=8000

# Metrics & Alerts
METRICS_ENABLED=true
ALERT_EMAIL=alerts@investbyyourself.com

# =====================================================
# ADMIN TOOLS (Optional)
# =====================================================

# PgAdmin Database Management Tool
PGADMIN_DEFAULT_EMAIL=admin@investbyyourself.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# Grafana Monitoring Dashboard
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password_here

# =====================================================
# DEVELOPMENT SETTINGS
# =====================================================

# Auto-reload on code changes
AUTO_RELOAD=true

# Test Database
TEST_POSTGRES_DATABASE=investbyyourself_test
TEST_REDIS_DB=1

# Sample Data
LOAD_SAMPLE_DATA=true
SAMPLE_DATA_SIZE=1000

# Logging Configuration
LOG_FILE_PATH=logs/
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# =====================================================
# QUICK START GUIDE
# =====================================================
#
# REQUIRED (must set before running):
#   - POSTGRES_PASSWORD
#   - REDIS_PASSWORD
#   - JWT_SECRET_KEY
#
# RECOMMENDED (for full functionality):
#   - ALPHA_VANTAGE_API_KEY
#   - FRED_API_KEY
#
# OPTIONAL (for extended features):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - FMP_API_KEY
#   - MINIO credentials
#
# Start services:
#   docker-compose -f docker-compose.dev.yml up -d
#
# Verify health:
#   docker-compose -f docker-compose.dev.yml ps
#   curl http://localhost:8000/health
#   curl http://localhost:3000
#
# View logs:
#   docker-compose -f docker-compose.dev.yml logs -f
#
# Stop services:
#   docker-compose -f docker-compose.dev.yml down
#
# =====================================================
