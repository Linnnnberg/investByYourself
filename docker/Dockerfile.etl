# syntax=docker/dockerfile:1.7
# ETL Worker Dockerfile for investByYourself
# Story-005: ETL & Database Architecture Design
#
# Build with BuildKit enabled (default in Docker 23+):
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.etl -t ibyy-etl-worker .

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Install system dependencies (cache APT layers across rebuilds)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies (cached pip wheels)
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --upgrade pip && \
    pip install -r requirements.txt

# Install additional ETL-specific packages
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install \
    asyncpg \
    redis \
    minio \
    aiohttp \
    asyncio-mqtt \
    prometheus-client \
    structlog \
    python-json-logger

# Copy application code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY database/ ./database/
COPY config/ ./config/

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/cache

# Create non-root user
RUN useradd --create-home --shell /bin/bash etl_user && \
    chown -R etl_user:etl_user /app

# Switch to non-root user
USER etl_user

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Default command
CMD ["python", "-m", "src.etl.worker"]
